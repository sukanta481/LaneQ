# From your Supabase dashboard: Project Settings -> API
# Newer projects show "publishable" / "secret"; older ones show "anon" / "service_role".
# Either naming works — the app accepts both.

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Server-side only. Bypasses RLS — never expose this to the browser and never
# commit it. Used by the public tracking page and the n8n hook routes.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Any long random string. n8n must send it as: Authorization: Bearer <value>
N8N_API_SECRET=

# Used to build the tracking links sent over WhatsApp.
NEXT_PUBLIC_APP_URL=http://localhost:3000
